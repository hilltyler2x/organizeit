# Server-side only. Never put this in a VITE_ variable.
ANTHROPIC_API_KEY=
PORT=8787
# For a native (iOS/Android) build: where the API server is deployed.
# VITE_API_URL=https://organizeit.example.com
# Anyone opening the site must enter this once per device before photos are sorted.
# Required when the site is on the internet.
APP_PASSCODE=
# Per-IP cap on photos sorted per hour.
# SORTS_PER_HOUR=2000

# Subscriptions. With REVENUECAT_SECRET_KEY set, the phone app needs a subscription to sort
# (the passcode still works for the owner and the website).
# REVENUECAT_SECRET_KEY=sk_...
# REVENUECAT_ENTITLEMENT=organizeit_pro
# Postgres for the per-phone photo counts; without it they reset when the server restarts.
# DATABASE_URL=postgres://...
# FREE_SORT_LIMIT=100
# INTRO_SORT_LIMIT=2000
# MONTHLY_SORT_LIMIT=0
# Sorting models: everything goes to the first, unsure photos (confidence below
# CLASSIFY_ESCALATE_BELOW) go to the second. CLASSIFY_ESCALATE_MODEL=none turns that off.
# CLASSIFY_MODEL=claude-haiku-5-5
# CLASSIFY_ESCALATE_MODEL=claude-opus-5-5
# CLASSIFY_ESCALATE_BELOW=0.75
